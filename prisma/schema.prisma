generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum TeamType {
  village
  loup
  independant
  multi
}

model Role {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  shortName   String      @unique
  slug        String      @unique
  description String
  team        TeamType
  color       String?
  objectif    String?
  isUnique    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  roleHooks   RoleHook[]
}

model GameStep {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  sentence    String
  orderIndex  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  roleHooks   RoleHook[]
}

model RoleHook {
  id        Int       @id @default(autoincrement())
  roleId    Int
  hookId    Int
  action    String
  role      Role      @relation(fields: [roleId], references: [id])
  hook      GameStep  @relation(fields: [hookId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([roleId, hookId])
}