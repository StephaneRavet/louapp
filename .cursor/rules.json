{
  "formatting": {
    "indentSize": 2,
    "useTabs": false,
    "quoteStyle": "single",
    "trailingComma": "es5",
    "semicolons": false,
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid"
  },
  "fileStructure": {
    "componentsDir": "src/components",
    "pagesDir": "src/app",
    "utilsDir": "src/lib",
    "dbDir": "prisma",
    "typesDir": "src/types",
    "testsDir": "src/lib/__tests__",
    "uiComponentsDir": "src/components/ui",
    "apiDir": "src/app/api",
    "actionsDir": "src/app/actions",
    "storeDir": "src/app/store"
  },
  "naming": {
    "components": "PascalCase",
    "functions": "camelCase",
    "variables": "camelCase",
    "constants": "UPPER_CASE",
    "files": {
      "components": "kebab-case",
      "utils": "kebab-case",
      "types": "PascalCase.type.ts"
    },
    "database": {
      "models": "PascalCase",
      "fields": "camelCase",
      "enums": "PascalCase"
    }
  },
  "comments": {
    "componentDoc": false,
    "functionDoc": false
  },
  "imports": {
    "sortOrder": ["react", "next", "external", "internal", "relative"]
  },
  "packageManager": {
    "use": "pnpm",
    "version": "10.6.5",
    "avoid": ["npm", "yarn"],
    "installCommand": "pnpm add",
    "devDependencyCommand": "pnpm add -D"
  },
  "database": {
    "preferredORM": "prisma",
    "version": "6.5.0",
    "seedDataFormat": "upsert",
    "models": {
      "Role": {
        "requiredFields": ["name", "shortName", "slug", "description", "team"],
        "defaultValues": {
          "isUnique": true
        }
      },
      "GameStep": {
        "requiredFields": ["name", "slug", "orderIndex"]
      },
      "RoleHook": {
        "requiredFields": ["roleId", "hookId", "action"]
      }
    }
  },
  "typescript": {
    "strictMode": true,
    "noImplicitAny": true,
    "useTypeImports": true,
    "preferInterfaceOverType": true
  },
  "react": {
    "preferFunctionalComponents": true,
    "useHooks": true,
    "avoidClassComponents": true,
    "preferDestructuring": true,
    "stateManager": "zustand"
  },
  "nextjs": {
    "useAppRouter": true,
    "useTurbopack": true,
    "useServerActions": true,
    "apiStyle": "route.ts"
  },
  "testing": {
    "framework": "jest",
    "filePattern": "**/__tests__/**/*.test.ts",
    "coverage": true
  },
  "environment": {
    "dotEnvLocation": ".env",
    "requiredVars": [
      "DATABASE_URL",
      "NEXT_PUBLIC_APP_URL"
    ],
    "productionProvider": "sqlite",
    "developmentProvider": "sqlite"
  },
  "seo": {
    "includeMetadata": true,
    "titleFormat": "%s | LouApp",
    "defaultDescription": "Application d'aide pour les maîtres du jeu de Loup-Garou",
    "includeOpenGraph": true
  },
  "deployment": {
    "platform": "vercel",
    "node": "18.x",
    "buildCommand": "pnpm build",
    "devCommand": "pnpm dev"
  },
  "errorHandling": {
    "serverErrors": {
      "logToConsole": true,
      "returnFormat": "{ success: false, error: string }"
    },
    "clientErrors": {
      "useErrorBoundary": false,
      "useErrorComponent": true
    }
  }
} 